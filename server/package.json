{
  "name": "leave-ease-server",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Amit Bhandari",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/seeds/seedAdmin.js",
    "seed:test-users": "node src/seeds/seedTestUsers.js",
    "seed:leave-balances": "node src/seeds/seedLeaveBalances.js",
    "seed:notification": "node src/seeds/seedNotification.js",
    "seed:audit-log": "node src/seeds/seedAuditLog.js",
    "test:working-days": "node src/tests/calculateWorkingDays.test.js",
    "test:integration": "node --env-file=.env.test --test --test-concurrency=1 src/tests/integration/*.test.js",
    "test:auth": "node --env-file=.env.test --test --test-concurrency=1 src/tests/integration/auth.integration.test.js",
    "test:leave": "node --env-file=.env.test --test --test-concurrency=1 src/tests/integration/leaveLifecycle.integration.test.js",
    "test:rbac": "node --env-file=.env.test --test --test-concurrency=1 src/tests/integration/rbacAdmin.integration.test.js",
    "check:env": "node --env-file=.env -e \"import('./src/config/validateEnvironment.js').then(({ validateEnvironment }) => { validateEnvironment(); console.log('Environment configuration is valid'); })\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
